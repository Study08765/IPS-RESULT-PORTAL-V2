<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<link rel="manifest" href="./manifest.json">

<meta name="theme-color" content="#071a3d">

<link rel="icon" type="image/png" sizes="192x192" href="./icon-192.png">
<link rel="apple-touch-icon" href="./icon-192.png">

<title>IPSPS PORTAL - IPS PUBLIC SCHOOL</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link
href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&display=swap"
rel="stylesheet">

<link
rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">


<style>

/* =====================================================
GLOBAL
===================================================== */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Poppins',sans-serif;
}

html{
    scroll-behavior:smooth;
}

body{

    background:
    radial-gradient(
        circle at 10% 5%,
        rgba(38,103,211,.10),
        transparent 25%
    ),

    radial-gradient(
        circle at 90% 30%,
        rgba(212,175,55,.10),
        transparent 25%
    ),

    #f4f7fc;

    color:#122750;

    overflow-x:hidden;
}


/* =====================================================
HERO IMAGE
FULL IMAGE - NO CROP
===================================================== */

.hero-image{

    width:100%;

    background:
    linear-gradient(
        180deg,
        #eaf0f8,
        #f4f7fc
    );

    overflow:hidden;

    line-height:0;

    border-bottom:1px solid #dbe4f2;
}


.hero-image img{

    width:100%;

    height:auto;

    display:block;

    object-fit:contain;

    object-position:center;

    filter:
    brightness(1.06)
    saturate(.94)
    contrast(.97);

    transition:transform .8s ease;
}


.hero-image:hover img{

    transform:scale(1.01);
}


/* =====================================================
MAIN PREMIUM CONTAINER
===================================================== */

.main-container{

    width:min(1120px,94%);

    margin:-32px auto 0;

    position:relative;

    z-index:5;
}


/* =====================================================
LUXURY SCHOOL CARD
===================================================== */

.school-card{

    position:relative;

    padding:30px 35px 32px;

    border-radius:35px;

    background:

    linear-gradient(
        145deg,
        rgba(255,255,255,.98),
        rgba(240,246,255,.96)
    );

    border:1px solid rgba(255,255,255,.95);

    box-shadow:

    0 30px 80px rgba(7,35,80,.20),

    0 8px 25px rgba(7,35,80,.08),

    inset 0 1px 0 #fff;

    overflow:hidden;

    backdrop-filter:blur(15px);
}


.school-card::before{

    content:"";

    position:absolute;

    width:330px;

    height:330px;

    border-radius:50%;

    right:-180px;

    top:-180px;

    background:

    radial-gradient(
        circle,
        rgba(37,99,235,.12),
        transparent 68%
    );
}


.school-card::after{

    content:"";

    position:absolute;

    width:280px;

    height:280px;

    border-radius:50%;

    left:-170px;

    bottom:-170px;

    background:

    radial-gradient(
        circle,
        rgba(212,175,55,.10),
        transparent 68%
    );
}


/* =====================================================
GOLD TOP
===================================================== */

.luxury-line{

    width:100px;

    height:5px;

    margin:0 auto 15px;

    border-radius:50px;

    background:

    linear-gradient(
        90deg,
        #a87810,
        #f8df79,
        #c49720,
        #f8df79,
        #a87810
    );

    box-shadow:

    0 3px 12px rgba(212,175,55,.30);
}


/* =====================================================
LOGO
===================================================== */

.logo{

    position:relative;

    z-index:2;

    width:105px;

    height:105px;

    margin:0 auto 13px;

    padding:7px;

    border-radius:50%;

    background:#fff;

    border:4px solid #d8b43c;

    box-shadow:

    0 0 0 8px rgba(255,215,0,.08),

    0 15px 35px rgba(8,40,90,.20);
}


.logo img{

    width:100%;

    height:100%;

    object-fit:contain;

    border-radius:50%;
}


/* =====================================================
SCHOOL NAME
===================================================== */

.school-name{

    position:relative;

    z-index:2;

    text-align:center;

    color:#0a3a8b;

    font-size:
    clamp(
        30px,
        5vw,
        55px
    );

    line-height:1;

    font-weight:900;

    letter-spacing:2px;

    text-shadow:

    0 4px 12px rgba(10,58,139,.13);
}


.school-place{

    position:relative;

    z-index:2;

    text-align:center;

    margin-top:8px;

    color:#b08416;

    font-size:13px;

    font-weight:800;

    letter-spacing:4px;
}


/* =====================================================
EXAM
===================================================== */

#examTitle{

    position:relative;

    z-index:2;

    margin-top:17px !important;

    text-align:center;

    color:#142d61 !important;

    font-size:
    clamp(
        20px,
        4vw,
        30px
    ) !important;

    line-height:1.15;

    font-weight:900 !important;

    text-shadow:none !important;
}


#sessionTitle{

    position:relative;

    z-index:2;

    margin-top:5px !important;

    text-align:center;

    color:#71809a !important;

    font-size:14px;

    font-weight:600;
}


/* =====================================================
LIVE STATUS
===================================================== */

.live{

    position:relative;

    z-index:2;

    display:flex;

    width:max-content;

    align-items:center;

    justify-content:center;

    gap:9px;

    margin:13px auto 20px;

    padding:9px 23px;

    border-radius:50px;

    color:#fff;

    font-size:12px;

    font-weight:800;

    background:

    linear-gradient(
        180deg,
        #3ddca1,
        #0e9465
    );

    border:1px solid rgba(255,255,255,.7);

    box-shadow:

    inset 0 2px 2px rgba(255,255,255,.4),

    0 10px 25px rgba(16,185,129,.30);
}


.live::before{

    content:"";

    width:9px;

    height:9px;

    border-radius:50%;

    background:#fff;

    box-shadow:

    0 0 0 5px rgba(255,255,255,.16);
}


/* =====================================================
RESULT PREMIUM PANEL
===================================================== */

.result-panel{

    position:relative;

    z-index:2;

    padding:30px 32px 32px;

    border-radius:27px;

    background:

    linear-gradient(
        145deg,
        #ffffff,
        #edf4ff
    );

    border:1px solid #dce6f5;

    box-shadow:

    0 18px 45px rgba(9,40,90,.12),

    inset 0 1px 0 #fff;
}


.result-heading-line{

    width:70px;

    height:4px;

    margin:0 auto 11px;

    border-radius:50px;

    background:

    linear-gradient(
        90deg,
        #b88817,
        #f5d66a,
        #b88817
    );
}


.result-title{

    text-align:center;

    color:#0a3d91;

    font-size:
    clamp(
        23px,
        4vw,
        31px
    );

    font-weight:900;
}


.result-subtitle{

    text-align:center;

    color:#74839c;

    font-size:13px;

    margin-top:4px;

    margin-bottom:23px;
}


/* =====================================================
INPUT AREA
===================================================== */

.result-form{

    display:grid;

    grid-template-columns:
    1fr 1fr;

    gap:18px;
}


.field label{

    display:block;

    color:#18356c;

    font-size:12px;

    font-weight:800;

    margin-bottom:7px;
}


.field label i{

    color:#bd921f;

    margin-right:5px;
}


.result-input{

    width:100%;

    height:55px;

    padding:0 16px;

    border-radius:14px;

    border:2px solid #dfe7f3;

    outline:none;

    background:#fff;

    color:#172b52;

    font-size:14px;

    font-weight:500;

    box-shadow:

    inset 0 3px 7px rgba(10,40,90,.045),

    0 5px 15px rgba(10,40,90,.04);

    transition:.25s;
}


.result-input:focus{

    border-color:#2c78df;

    box-shadow:

    0 0 0 4px rgba(37,99,235,.10),

    0 8px 20px rgba(37,99,235,.08);
}


/* =====================================================
3D VIEW RESULT
===================================================== */

.view-result-btn{

    width:100%;

    height:60px;

    margin-top:20px;

    border:0;

    border-radius:15px;

    cursor:pointer;

    color:#fff;

    font-size:16px;

    font-weight:900;

    letter-spacing:1.5px;

    background:

    linear-gradient(
        180deg,
        #4b9cff 0%,
        #1769d5 48%,
        #0a3f91 100%
    );

    box-shadow:

    0 7px 0 #062e70,

    0 18px 35px rgba(11,61,145,.32),

    inset 0 2px 2px rgba(255,255,255,.45),

    inset 0 -5px 10px rgba(0,0,0,.10);

    transition:.15s;
}


.view-result-btn:hover{

    transform:translateY(-3px);

    filter:brightness(1.06);

    box-shadow:

    0 10px 0 #062e70,

    0 24px 42px rgba(11,61,145,.38),

    inset 0 2px 2px rgba(255,255,255,.45);
}


.view-result-btn:active{

    transform:translateY(6px);

    box-shadow:

    0 2px 0 #062e70,

    0 8px 15px rgba(11,61,145,.22);
}


/* =====================================================
LOGIN AREA
===================================================== */

.login-container{

    width:100%;

    display:grid;

    grid-template-columns:
    repeat(3,1fr);

    gap:18px;

    margin-top:22px;
}


.login-card{

    position:relative;

    padding:23px 20px;

    text-align:center;

    border-radius:24px;

    background:

    linear-gradient(
        145deg,
        #ffffff,
        #edf4ff
    );

    border:1px solid #e0e8f4;

    box-shadow:

    0 15px 35px rgba(10,40,90,.12),

    inset 0 1px 0 #fff;

    transition:.3s;
}


.login-card:hover{

    transform:translateY(-8px);

    box-shadow:

    0 25px 45px rgba(10,40,90,.18);
}


.login-icon{

    width:62px;

    height:62px;

    margin:0 auto 12px;

    display:flex;

    align-items:center;

    justify-content:center;

    border-radius:18px;

    color:#fff;

    font-size:27px;

    background:

    linear-gradient(
        145deg,
        #4294ff,
        #0a3d91
    );

    box-shadow:

    0 6px 0 #062e70,

    0 12px 25px rgba(11,61,145,.27);
}


.login-card h3{

    color:#102d63;

    font-size:17px;

    font-weight:800;
}


.login-btn{

    display:block;

    margin-top:15px;

    padding:12px;

    text-decoration:none;

    color:#fff;

    border-radius:11px;

    font-size:13px;

    font-weight:800;

    background:

    linear-gradient(
        180deg,
        #3d8fff,
        #0b3d91
    );

    box-shadow:

    0 4px 0 #062e70,

    0 9px 18px rgba(11,61,145,.20);
}


/* =====================================================
ANNOUNCEMENT
===================================================== */

.notice-section{

    width:100%;

    margin-top:20px;

    padding:20px;

    border-radius:23px;

    background:#fff;

    border:1px solid #e0e7f3;

    box-shadow:

    0 13px 30px rgba(10,40,90,.09);
}


.notice-section h2{

    text-align:center;

    color:#102d63;

    font-size:19px;

    font-weight:800;

    margin-bottom:11px;
}


.notice-section marquee{

    display:block;

    padding:11px;

    border-radius:11px;

    background:#fff7f7;

    border:1px solid #f0d5d5;

    color:#ad2727;

    font-size:12px;

    font-weight:600;
}


#countdown{

    margin-top:8px !important;

    color:#0b3d91;

    text-align:center;

    font-size:12px !important;

    font-weight:700;
}


/* =====================================================
RESULT OUTPUT
===================================================== */

#result:empty{

    display:none;
}


.result-card{

    width:100%;

    margin-top:20px;

    padding:28px;

    border-radius:25px;

    background:#fff;

    box-shadow:

    0 20px 45px rgba(10,40,90,.15);
}


/* =====================================================
FOOTER
===================================================== */

.footer{

    margin-top:30px;

    padding:17px 15px;

    text-align:center;

    color:#fff;

    background:

    linear-gradient(
        135deg,
        #05193c,
        #0b3d91
    );

    border-top:2px solid #d9b43b;
}


.footer .developer{

    margin:0;

    font-size:13px;

    font-weight:600;
}


.footer strong{

    color:#f5d36a;
}


/* =====================================================
WHATSAPP
===================================================== */

.whatsapp-btn{

    position:fixed;

    right:20px;

    bottom:25px;

    width:58px;

    height:58px;

    display:flex;

    align-items:center;

    justify-content:center;

    border-radius:50%;

    color:#fff;

    background:#25D366;

    text-decoration:none;

    font-size:28px;

    box-shadow:

    0 6px 0 #159947,

    0 14px 25px rgba(37,211,102,.32);

    z-index:999;
}


/* =====================================================
MOBILE
===================================================== */

@media(max-width:700px){

    .main-container{

        width:94%;

        margin:-18px auto 0;
    }


    .school-card{

        padding:22px 15px 23px;

        border-radius:27px;
    }


    .logo{

        width:78px;

        height:78px;
    }


    .school-name{

        font-size:28px;

        letter-spacing:1px;
    }


    .school-place{

        font-size:10px;

        letter-spacing:2px;
    }


    #examTitle{

        font-size:20px !important;
    }


    #sessionTitle{

        font-size:11px;
    }


    .live{

        margin-bottom:15px;

        padding:8px 17px;

        font-size:10px;
    }


    .result-panel{

        padding:21px 15px 22px;

        border-radius:21px;
    }


    .result-title{

        font-size:21px;
    }


    .result-subtitle{

        font-size:11px;

        margin-bottom:17px;
    }


    .result-form{

        grid-template-columns:1fr;

        gap:13px;
    }


    .result-input{

        height:49px;
    }


    .view-result-btn{

        height:53px;

        font-size:14px;
    }


    .login-container{

        grid-template-columns:1fr;

        gap:12px;

        margin-top:16px;
    }


    .login-card{

        padding:17px;

    }


    .login-icon{

        width:52px;

        height:52px;

        font-size:23px;
    }


    .login-card h3{

        font-size:16px;
    }


    .login-btn{

        margin-top:11px;

        padding:10px;
    }


    .notice-section{

        margin-top:16px;

        padding:15px;
    }


    .notice-section h2{

        font-size:17px;
    }


    .footer{

        margin-top:20px;
    }

}


/* =====================================================
VERY SMALL MOBILE
===================================================== */

@media(max-width:380px){

    .school-name{

        font-size:24px;
    }


    .logo{

        width:68px;

        height:68px;
    }


    .result-title{

        font-size:19px;
    }

}

</style>

</head>


<body>


<!-- =====================================================
FULL CLEAN HERO IMAGE
===================================================== -->

<section class="hero-image">

<img
src="hero-bg.jpg"
alt="IPS PUBLIC SCHOOL">

</section>


<!-- =====================================================
MAIN
===================================================== -->

<div class="main-container">


<!-- =====================================================
SCHOOL + RESULT ONE CARD
===================================================== -->

<section class="school-card">


<div class="luxury-line"></div>


<div class="logo">

<img
src="logo.png"
alt="IPS PUBLIC SCHOOL Logo">

</div>


<h1 class="school-name">

IPS PUBLIC SCHOOL

</h1>


<p class="school-place">

AHIRORI • HARDOI

</p>


<h2 id="examTitle">

Loading...

</h2>


<h3 id="sessionTitle">

Loading...

</h3>


<div
class="live"
id="resultLive">

Loading...

</div>


<!-- =====================================================
RESULT PANEL
===================================================== -->

<div class="result-panel">


<div class="result-heading-line"></div>


<h2 class="result-title">

🏆 SEARCH YOUR RESULT

</h2>


<p class="result-subtitle">

Enter your class and roll number to view your result

</p>


<div class="result-form">


<div class="field">


<label>

<i class="fa-solid fa-graduation-cap"></i>

SELECT CLASS

</label>


<select
class="result-input"
id="class">


<option
selected
disabled>

Select Class

</option>


<option>
Class 3
</option>

<option>
Class 4
</option>

<option>
Class 5
</option>

<option>
Class 6
</option>

<option>
Class 7
</option>

<option>
Class 8
</option>


</select>


</div>


<div class="field">


<label>

<i class="fa-solid fa-hashtag"></i>

ROLL NUMBER

</label>


<input
type="number"
id="roll"
class="result-input"
placeholder="Enter Roll Number">


</div>


</div>


<button
class="view-result-btn"
onclick="searchResult()">

<i class="fa-solid fa-magnifying-glass"></i>

&nbsp;

VIEW RESULT

</button>


</div>


</section>


<!-- =====================================================
RESULT OUTPUT
===================================================== -->

<div id="result"></div>


<!-- =====================================================
LOGIN CARDS
===================================================== -->

<div class="login-container">


<div class="login-card">


<div class="login-icon">

<i class="fa-solid fa-user-graduate"></i>

</div>


<h3>

Student Login

</h3>


<a
href="student-login.html"
class="login-btn">

LOGIN

&nbsp;

<i class="fa-solid fa-arrow-right"></i>

</a>


</div>


<div class="login-card">


<div class="login-icon">

<i class="fa-solid fa-chalkboard-user"></i>

</div>


<h3>

Staff Login

</h3>


<a
href="staff-login.html"
class="login-btn">

LOGIN

&nbsp;

<i class="fa-solid fa-arrow-right"></i>

</a>


</div>


<div class="login-card">


<div class="login-icon">

<i class="fa-solid fa-user-shield"></i>

</div>


<h3>

Admin Login

</h3>


<a
href="login.html"
class="login-btn">

LOGIN

&nbsp;

<i class="fa-solid fa-arrow-right"></i>

</a>


</div>


</div>


<!-- =====================================================
ANNOUNCEMENT
===================================================== -->

<section
class="notice-section"
id="noticeBox">


<h2>

📢 Latest Announcements

</h2>


<marquee
id="noticeTextShow"
behavior="scroll"
direction="left">

Loading...

</marquee>


<div
id="countdown">

</div>


</section>


</div>


<!-- =====================================================
FOOTER
===================================================== -->

<footer class="footer">


<p class="developer">

Developed &amp; Designed by

<strong>
A.K. SINGH CHANDEL
</strong>

</p>


</footer>


<!-- =====================================================
WHATSAPP
===================================================== -->

<a
href="https://wa.me/8127803733"
class="whatsapp-btn"
target="_blank">

<i class="fa-brands fa-whatsapp"></i>

</a>


<!-- =====================================================
FIREBASE / EXISTING APP
===================================================== -->

<script
type="module"
src="app.js">
</script>


<!-- =====================================================
SERVICE WORKER
===================================================== -->

<script>

if("serviceWorker" in navigator){

    window.addEventListener(
        "load",
        function(){

            navigator
            .serviceWorker
            .register("./sw.js")

            .then(function(){

                console.log(
                    "IPSPS Service Worker Registered Successfully"
                );

            })

            .catch(function(error){

                console.error(
                    "IPSPS Service Worker Registration Failed:",
                    error
                );

            });

        }
    );

}

</script>


</body>

  </html>
